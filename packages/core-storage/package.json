{
  "name": "argusai-core-storage",
  "version": "0.14.0",
  "type": "module",
  "description": "ArgusAI storage layer — SQLite/Drizzle history, knowledge base, and team sync for E2E test results",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffkit/argusai.git",
    "directory": "packages/core-storage"
  },
  "keywords": [
    "argusai",
    "e2e",
    "testing",
    "sqlite",
    "drizzle",
    "history"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.39.0"
  },
  "peerDependencies": {
    "pg": ">=8.0.0",
    "mysql2": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
